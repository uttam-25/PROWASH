{
  "name": "prowash-server",
  "version": "1.0.0",
  "description": "PROWASH backend API — Node.js/Express/MongoDB",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed:admin": "node scripts/seedAdmin.js",
    "seed:services": "node scripts/seedServices.js",
    "seed:schedule": "node scripts/seedSchedule.js",
    "seed:full": "node scripts/seedAdmin.js && node scripts/seedServices.js && node scripts/seedSchedule.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.6",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.14",
    "razorpay": "^2.9.2",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
