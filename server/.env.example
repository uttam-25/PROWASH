PORT=5000
MONGO_URI=mongodb://localhost:27017/prowash
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=7d
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────────────────────────────
# Set to your frontend origin in production (e.g. https://app.prowash.com)
# Leave unset or use '*' for open access (development only)
CORS_ORIGIN=

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
ADMIN_EMAIL=admin@prowash.com
ADMIN_PASSWORD=Admin@1234
ADMIN_NAME=ProWash Admin
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Vehicle Registration Lookup ───────────────────────────────────────────────
# Provider: "rapidapi" (India Vehicle Registration Info on RapidAPI) or "none"
# Get your key at: https://rapidapi.com/coredata/api/india-vehicle-registration-info
VEHICLE_LOOKUP_PROVIDER=none
VEHICLE_LOOKUP_API_KEY=
VEHICLE_LOOKUP_API_URL=
